# Auto detect text files and perform LF normalization
* text=auto

# 벡터 레이어는 LF 로 둔다. core.autocrlf=true 인 Windows 에서 받으면 CRLF 로 바뀌어
# 43만 줄짜리 파일이 0.4 MB 커지고 원본과 바이트가 달라진다.
GUMAP-데이터/vector_layers/*.geojson text eol=lf

# 캠퍼스맵 배포 파일은 LF 로 둔다. 학교 서버에 올라가는 바이트가 저장소와 같아야 한다.
kit-campus-map/**/*.js text eol=lf
kit-campus-map/**/*.css text eol=lf
kit-campus-map/**/*.html text eol=lf
kit-campus-map/**/*.json text eol=lf
kit-campus-map/**/*.geojson text eol=lf
kit-campus-map/**/*.svg text eol=lf
kit-campus-map/**/*.md text eol=lf
kit-campus-map/**/*.py text eol=lf
