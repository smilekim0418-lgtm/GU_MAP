# =========================================================
# GuMap 환경변수 설정 예시 (.env.example -> .env 로 복사하여 사용)
# * 주의: 핵심 지도 렌더링, 자동차 길찾기, 구미 전역 339개 버스 대중교통 길찾기는
#   아래 API 키가 없어도 100% 로컬 데이터 및 오픈소스 엔진으로 작동합니다.
# =========================================================

# [선택] 국토교통부 TAGO 실시간 버스 위치 API 키
TAGO_KEY=

# [선택] Google Gemini 자연어 AI 검색 비서 API 키
GEMINI_API_KEY=

# [선택] VWorld 위성지도 / 지오코딩 API 키
VWORLD_KEY=

# [선택] 국가교통정보센터(ITS) 실시간 CCTV / 돌발정보 API 키
ITS_KEY=

# [선택] 한국석유공사 오피넷 실시간 주유소 유가 API 키
OPINET_KEY=

# [선택] ngrok 외부 터널링 연동 설정
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

